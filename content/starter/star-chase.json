      "description": "The Demon attacks anyone who lands on its lair.",
      "trigger": {
        "event": "landed",
        "where": {
          "spaceTag": "tag.lair",
          "actorKind": "contestant"
        }
      },
      "effects": [
        {
          "op": "fight",
          "attacker": {
            "op": "filter",
            "from": {
              "op": "at",
              "space": "$space",
              "kind": "enemy"
            },
            "where": {
              "op": "hasTag",
              "entity": "$it",
              "tag": "tag.demon"
            }
          },
          "defender": "$actor"
        }
      ]
    },
    {
      "id": "rule.star_vendor_moves",
      "name": "Star Vendor Moves",
      "description": "After selling a star, the vendor relocates to another star spot.",
      "trigger": {
        "event": "purchased",
        "where": {
          "shopEntry": "entry.star"
        }
      },
      "effects": [
        {
          "op": "teleport",
          "target": "$target",
          "to": {
            "op": "randomSpace",
            "tag": "tag.star_spot",
            "excludeSpaceOf": "$target"
          }
        },
        {
          "op": "announce",
          "text": "The Star Vendor packs up and moves on."
        }
      ]
    },
    {
      "id": "rule.mystery",
      "name": "Mystery Space",
      "trigger": {
        "event": "landed",
        "where": {
          "spaceTag": "tag.event",
          "actorKind": "contestant"
        }
      },
      "effects": [
        {
          "op": "drawCard",
          "deck": "deck.island",
          "for": "$actor"
        }
      ]
    },
    {
      "id": "rule.fish_out_of_water",
      "name": "Fish Out of Water",
      "kind": "continuous",
      "applies": {
        "op": "withTag",
        "tag": "tag.fish",
        "kind": "contestant"
      },
      "when": {
        "op": "not",
        "cond": {
          "op": "spaceHasTag",
          "space": {
            "op": "spaceOf",
            "entity": "$it"
          },
          "tag": "tag.blue"
        }
      },
      "modifiers": [
        {
          "resource": "res.power",
          "add": -40
        }
      ]
    },
    {
      "id": "rule.sanctuary",
      "name": "Harbor Sanctuary",
      "kind": "continuous",
      "description": "Nobody can be attacked at Harbor Gate.",
      "applies": {
        "op": "all",
        "kind": "contestant"
      },
      "when": {
        "op": "spaceHasTag",
        "space": {
          "op": "spaceOf",
          "entity": "$it"
        },
        "tag": "tag.start"
      },
      "suppress": [
        "attackable"
      ]
    }
  ]
}
