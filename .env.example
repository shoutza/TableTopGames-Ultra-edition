# Copy to .env (git-ignored). The server and sim CLI read it at startup.
# Without OPENAI_API_KEY, contestants are played by the offline heuristic controller.
OPENAI_API_KEY=
# Contestant decision model (OpenAI Responses API).
TTG_CONTESTANT_MODEL=gpt-6-luna
# Optional reasoning effort sent to the provider; leave empty for the model default.
TTG_CONTESTANT_REASONING_EFFORT=
# Natural-language authoring model (later milestone, optional).
TTG_AUTHORING_MODEL=
TTG_PORT=5173
TTG_DATA_DIR=data
